# Claude API Key
CLAUDE_API_KEY=sua_chave_claude_aqui

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=seu_token_meta_aqui
PHONE_NUMBER_ID=seu_phone_number_id_aqui
VERIFY_TOKEN=assis-xavier-verify-token
# Chave secreta do aplicativo (Meta for Developers > seu app > Configuracoes > Basico).
# Valida a assinatura X-Hub-Signature-256 de cada chamada ao /webhook.
# Sem ela o bot funciona, mas aceita chamadas nao assinadas (o /health mostra "appSecret": false).
APP_SECRET=sua_chave_secreta_do_app_meta_aqui

# Escritório
ESCRITORIO_PHONE=+55 (44)99977-8551

# Servidor
PORT=3000
NODE_ENV=production

# Transcricao de audio (chave gratuita em console.groq.com)
TRANSCRIBE_API_KEY=sua_chave_groq_aqui

# Recado de voz da Ana (ElevenLabs). So responde com voz quando o ultimo recado do
# cliente foi audio. Desligado por padrao: so liga com true, 1 ou yes.
VOICE_REPLIES_ENABLED=false
# Chave da ElevenLabs (elevenlabs.io > API Keys). Sem ela, a Ana responde em texto.
ELEVENLABS_API_KEY=sua_chave_elevenlabs_aqui
# Voz Sofia (Natural & Expressive) e modelo multilingual v2
ELEVENLABS_VOICE_ID=n2a9VtkZLl8j1FSXHsL7
ELEVENLABS_MODEL=eleven_multilingual_v2
# Acima deste tamanho (texto ja normalizado) a resposta vai em texto
VOICE_MAX_CHARS=600
# Maximo de recados de voz por cliente, por dia (vira a meia-noite de Brasilia)
VOICE_CLIENT_DAILY_LIMIT=6
# Teto diario de caracteres enviados a ElevenLabs (1 credito por caractere)
VOICE_DAILY_CHAR_LIMIT=2500

# OPCIONAL: intervalo minimo, em horas, entre dois avisos imediatos de urgencia em curso
# na mesma conversa (aviso ao Dr. Willian e a Dra. Aline). Sem a variavel, vale 6.
# URGENCIA_ALERTA_HORAS=6
