# ── Bot da Ana (atendimento ao cliente) ──────────────────────────────────────
CLAUDE_API_KEY=sua_chave_claude_aqui
WHATSAPP_TOKEN=token_whatsapp_da_ana
PHONE_NUMBER_ID=id_numero_da_ana
VERIFY_TOKEN=assis-xavier-verify-token
ESCRITORIO_PHONE=+55 (44)99977-8551
PORT=3000
NODE_ENV=production

# ── Agente de Anúncios (Meta Ads) ────────────────────────────────────────────
# Token de acesso do Meta Ads — gere no Graph API Explorer (developers.facebook.com/tools/explorer)
META_ADS_TOKEN=seu_token_meta_ads_aqui

# ID da conta de anúncios — já preenchido
META_AD_ACCOUNT_ID=act_2543342975818856

# ID da Página do Facebook do escritório
META_PAGE_ID=161951133661934

# Número de WhatsApp para onde os anúncios vão direcionar os clientes
META_WHATSAPP_NUMBER=5544999784442

# Telefone do dono — único número autorizado a enviar comandos ao agente
OWNER_PHONE=5544999784442

# ── WhatsApp do Agente de Anúncios (segundo número — opcional) ───────────────
# Deixe em branco para usar só o endpoint REST (/ads-command)
ADS_WHATSAPP_TOKEN=token_segundo_numero_whatsapp
ADS_PHONE_NUMBER_ID=id_segundo_numero_whatsapp
ADS_VERIFY_TOKEN=ads-agent-verify-token
