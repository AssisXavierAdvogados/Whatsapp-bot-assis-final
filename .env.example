# ID da Página do Facebook (já preenchido)
META_PAGE_ID=161951133661934

# ID do usuário do Instagram Business
# Encontre em: Graph API Explorer → GET /me?fields=id,name com token de página
# Ou: business.facebook.com > Contas > Contas do Instagram > clique na conta
